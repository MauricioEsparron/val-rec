<Window x:Class="ValRec.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="gato.ico" Title="VAL Rec" Width="380" Height="460" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#14161A" Foreground="#E8EAED"
        FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,4,0,12"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,20,24,16">
        <TextBlock Text="VAL Rec" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="GpuText" Style="{StaticResource Label}" Margin="0,2,0,14"/>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RecBtn" Width="76" Height="76" Click="RecBtn_Click" Cursor="Hand" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="#E8EAED" StrokeThickness="3"/>
                            <Border x:Name="Dot" Background="#E5484D" CornerRadius="30" Margin="12"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="Background" Value="#FF5D62"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TimerText" Text="00:00:00" FontSize="28" FontWeight="Light" FontFamily="Consolas"/>
                <TextBlock x:Name="StatusText" Text="Listo · F9 inicia/detiene" Style="{StaticResource Label}"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Fotogramas por segundo" Style="{StaticResource Label}"/>
        <ComboBox x:Name="FpsBox"/>
        <TextBlock Text="Calidad" Style="{StaticResource Label}"/>
        <ComboBox x:Name="QualityBox"/>
        <CheckBox x:Name="AudioCheck" Content="Grabar audio del sistema" Foreground="#E8EAED" Margin="0,0,0,8"/>
        <Button Content="Colores y filtros… (editar un video)" Height="30" Margin="0,0,0,12" Click="Editor_Click"/>

        <TextBlock Text="Carpeta de salida" Style="{StaticResource Label}"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FolderBox" IsReadOnly="True" Height="28" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Cambiar" Width="64" Margin="6,0,0,0" Click="ChangeFolder_Click"/>
            <Button Grid.Column="2" Content="Abrir" Width="48" Margin="6,0,0,0" Click="OpenFolder_Click"/>
        </Grid>
    </StackPanel>
</Window>
